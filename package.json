{
    "name": "@tessellatepos/plugin-sdk",
    "version": "0.1.0-alpha",
    "description": "Curated contract surface for Tessellate POS plugins (client + server).",
    "type": "module",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/src/index.d.ts",
            "default": "./lib/src/index.js"
        },
        "./server": {
            "types": "./lib/src/server/index.d.ts",
            "default": "./lib/src/server/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "prettier . && eslint .",
        "lint:fix": "prettier . --write && eslint . --fix"
    },
    "dependencies": {
        "@tessellatepos/sdk": "workspace:*",
        "react": "^19.2.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^24.10.9",
        "@types/react": "^19.2.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "jiti": "^2.6.1",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.68.0"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    }
}
