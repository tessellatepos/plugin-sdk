{
    "name": "@tessellatepos/plugin-sdk",
    "version": "0.0.2-alpha",
    "description": "Curated contract surface for Tessellate POS plugins (client + server).",
    "author": "Tessellate POS <tessellate@travisfriesen.ca>",
    "license": "Apache-2.0",
    "type": "module",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/src/index.d.ts",
            "default": "./lib/src/index.js"
        },
        "./server": {
            "types": "./lib/src/server/index.d.ts",
            "default": "./lib/src/server/index.js"
        },
        "./host": {
            "types": "./lib/src/host/index.d.ts",
            "default": "./lib/src/host/index.js"
        },
        "./vite": {
            "types": "./lib/src/vite/index.d.ts",
            "default": "./lib/src/vite/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "prettier . && eslint .",
        "lint:fix": "prettier . --write && eslint . --fix"
    },
    "dependencies": {
        "@tessellatepos/sdk": "0.0.1-alpha"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "vite": "^7.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^24.10.9",
        "@types/react": "^19.2.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "jiti": "^2.6.1",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^7.3.1"
    }
}
